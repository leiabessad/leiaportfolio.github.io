 :root{
      --gap: 28px;
      --sidebar-w: 280px; /* unify width */
      --color-text: #111;
      --color-muted: #666;
      --bg: #fff;
      --bg-overlay: rgba(0,0,0,0.85);
      --transition: 0.3s ease;
      --font-title: "Helvetica Neue", Helvetica, Arial, sans-serif;
      --font-body: "Inter", sans-serif;
      --arrow-size: 50px;
    }

    *{box-sizing:border-box;margin:0;padding:0}
    body{
  font-family:var(--font-body);
  color:var(--color-text);
  line-height:1.6;
  overflow-x:hidden
}


  .logo {
    width: 100%;
    max-width: 180px; /* ajuste si besoin */
    height: auto;
  }
    
    /* layout */
    .container{display:grid;grid-template-columns:var(--sidebar-w) 1fr;min-height:100vh}

    /* sidebar */
    .sidebar{
      position:sticky;top:0;height:100vh;padding:var(--gap);
      border-right:1px solid #eee;background:#fff;
      display:flex;flex-direction:column;justify-content:space-between;
      transition:left var(--transition), transform var(--transition);
      z-index:1000;
    }
    .sidebar h1{font-size:22px;font-family:var(--font-title);margin-bottom: 10px;text-transform: uppercase;}
    .sidebar h1 a:link,
.sidebar h1 a:visited {
color: #111;
text-decoration: none;
transition: color var(--transition);
}

.sidebar h1 a:hover,
.sidebar h1 a:active {
color: #ff29a6;
text-decoration: none;
}
    .info-list,.project-list{list-style:none;display:flex;flex-direction:column;gap:12px;font-variation-settings: "wght" 400;}
    .info-list a,.project-list a{text-decoration:none;color:#8e8e8e;padding:4px 0;transition:color var(--transition),transform var(--transition); text-transform: uppercase;font-size: 14px;}
    .info-list a:hover{color:#00d9ff;transform:translateX(4px);}
    .project-list a:hover{color:#ff29a6;font-variation-settings: "wght" 700; transform: translateX(4px);transition: color 0.3s ease, transform 0.3s ease, text-shadow 0.3s ease;}
    .project-list .subtitle{font-size:.9rem;color:var(--color-muted);display:block}

    .next-project{margin-top:40px;padding-top:10px;border-top:1px solid #eee}
    .next-project a{text-decoration:none;color:var(--color-text);font-weight:bold;transition:color var(--transition)}
    .next-project a:hover{color:#00d9ff}

    /* gallery masonry */
    .gallery{padding:var(--gap);overflow-y:auto;}
    .masonry{column-count:3;column-gap:20px;padding:5px;border-radius:8px}
    .masonry-item{display:inline-block;width:100%;margin-bottom:10px;break-inside:avoid;position:relative;overflow:hidden;cursor:pointer;border-radius:8px}
   
    /* effet au hover */
.masonry-item:hover .overlay-text {
  opacity: 1;
  backdrop-filter: blur(2px);
  border-radius:8px;
}
    .masonry-item img{width:100%;height:auto;display:block;transition:transform 1.1s;border-radius:8px;}

    /* hamburger (hidden desktop) */
    .hamburger{display:none;position:fixed;top:20px;right:20px;z-index:1100;background:#fff;border:1px solid #ccc;padding:10px;border-radius:8px;cursor:pointer;box-shadow:0 2px 6px rgba(0,0,0,0.15)}
    .hamburger span{display:block;width:24px;height:3px;background:#111;margin:5px 0;transition:.3s}

    /* close button in sidebar (mobile) */
    .close-btn{display:none;position:absolute;top:15px;right:15px;font-size:24px;cursor:pointer;background:none;border:none}

    /* overlay (mobile menu + lightbox background reuse) */
    .overlay{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:var(--bg-overlay);z-index:900;opacity:0;transition:opacity var(--transition)}
    .overlay.active{display:block;opacity:1}

    /* --- Overlay texte sur images de la galerie --- */

.overlay-text {
  position: absolute;
  inset: 0; /* prend toute la place */
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(255, 255, 255, 0.8); /* fond blanc semi-transparent */
  color: #666; /* texte noir */
  font-family: var(--font-body);
  font-size: 16px;
  font-weight: 500;
  opacity: 0;
  transition: opacity 1.1s ease-in-out, backdrop-filter 1.1s ease-in-out;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-radius: 8px;
}



.masonry-item:hover img {
  transform: scale(1.05);
  filter: blur(3px) brightness(1,2);
  transition: transform 0.3s ease-in-out, filter 0.3s ease-in-out;
  border-radius:8px;
}



    /* mobile: sidebar becomes off-canvas */
    @media (max-width:900px){
      .container{grid-template-columns:1fr}
      .sidebar{
        position:fixed;left:-100%;top:0;width:80%;max-width:300px;height:100%;border-right:none;box-shadow:2px 0 10px rgba(0,0,0,0.1);transition:left var(--transition);
      }
      .sidebar.active{left:0}
      .hamburger{display:block}
      .close-btn{display:block}
      .masonry{column-count:2}
    }
    @media (max-width:500px){ .masonry{column-count:1} }

    /* lightbox (hidden by default) */
    .lightbox{
      position:fixed;top:0;left:0;width:100%;height:100%;background:var(--bg-overlay);
      display:flex;justify-content:center;align-items:center;opacity:0;pointer-events:none;transition:opacity var(--transition);z-index:2000;
    }
    .lightbox.active{opacity:1;pointer-events:auto}
    .lightbox img{max-width:90%;max-height:90%;border-radius:10px}
    .lightbox-arrow{position:absolute;top:50%;transform:translateY(-50%);font-size:var(--arrow-size);color:white;cursor:pointer;user-select:none;padding:10px;transition:.3s}
    .lightbox-arrow:hover{color:#00d9ff}
    .lightbox-arrow.left{left:20px}
    .lightbox-arrow.right{right:20px}
    .lightbox-close{position:absolute;top:20px;right:20px;font-size:28px;color:#fff;cursor:pointer;background:none;border:none}

    /* small niceties */
    a{cursor:pointer}
